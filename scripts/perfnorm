#!/bin/bash
printf "\033c" >> /dev/tty1
export SDL_VIDEO_EGL_DRIVER=libEGL.so
if [[ ! -z "$(tr -d '\0' < /proc/device-tree/compatible | grep rk3326)" ]] && [[ $(tty) != *"pts"* ]]; then
  cp /home/virtua/.asoundrcbak /home/virtua/.asoundrc
  gpu="ff400000"
else
  gpu="fde60000"
fi

# A four-way branch on /home/virtua/.config/.GameLoadingIMode{ASCII,GIF,VID,PIC} used to
# be here, each arm playing /roms/launchimages/loading.{ascii,gif,mp4,jpg} through ffplay
# or image-viewer while a game started.  It was EmulationStation's per-game loading
# screen: the front end set those flag files from its Options menu and the images came
# out of the roms tree.  Both are gone, launchimages/ was never created by this build in
# the first place, and every arm ended in a bare `continue' outside any loop -- which
# bash reports as an error on the one path it could ever have taken.
clear > /dev/tty1

echo simple_ondemand > /sys/devices/platform/${gpu}.gpu/devfreq/${gpu}.gpu/governor
echo ondemand > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
echo dmc_ondemand > /sys/devices/platform/dmc/devfreq/dmc/governor
