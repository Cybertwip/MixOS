#!/bin/bash
# p3 is the home partition now, mounted at /home/virtua, and /roms is a symlink into it.
# One variable, because this script both unmounts and repopulates it and the two have to
# agree; the fstab this ships beside says the same thing, from ${DATA_MOUNT_POINT} in
# setup_partition.sh.
DATA_MOUNT_POINT=/home/virtua
if mountpoint -q ${DATA_MOUNT_POINT}; then
  sudo umount ${DATA_MOUNT_POINT}
fi
sudo chmod 666 /dev/tty1
export TERM=linux
height="15"
width="55"
if [ -f "/boot/rk3326-a10mini-linux.dtb" ] || [ -f "/boot/rk3326-rg351v-linux.dtb" ] || [ -f "/boot/rk3326-rg351mp-linux.dtb" ] || [ -f "/boot/rk3326-g350-linux.dtb" ] || [ -f "/boot/rk3326-gameforce-linux.dtb" ] || [ -f "/boot/rk3326-odroidgo3-linux.dtb" ]; then
  sudo setfont /usr/share/consolefonts/Lat7-Terminus20x10.psf.gz
  height="20"
  width="60"
fi

if [ ! -f /boot/doneit ]; then
  sudo echo ", +" | sudo sfdisk -N 3 --force /dev/mmcblk0 &> /dev/null
  sudo touch "/boot/doneit"
  dialog --infobox "DATA partition expansion in process.  The device will now reboot to continue the process..." $height $width 2>&1 > /dev/tty1
  sleep 5
  sudo reboot
fi
(
	maxSize=$(lsblk -b --output SIZE -n -d /dev/mmcblk0)

	newExtSizePct=$(printf %.2f "$((10**4 * 11000000000/$maxSize))e-4")
	newExtSizePct=$(echo print 1-$newExtSizePct | perl)
	ExfatPctToRemain=$(echo print 100*$newExtSizePct | perl)

	partition_type=$(df -T | grep mmcblk[0-1]p2 | cut -d ' ' -f 2)
	if [ $ExfatPctToRemain -lt "100" ]; then
	  printf "d\n3\nw\n" | sudo fdisk /dev/mmcblk0 &> /dev/null
	  sudo growpart --free-percent=$ExfatPctToRemain -v /dev/mmcblk0 2 &> /dev/null
	  if [[ "$partition_type" == *"ext"* ]]; then
		sudo resize2fs /dev/mmcblk0p2 &> /dev/null
	  elif [[ "$partition_type" == *"xfs"* ]]; then
		sudo xfs_growfs /dev/mmcblk0p2 &> /dev/null
	  elif [[ "$partition_type" == *"btrfs"* ]]; then
		sudo btrfs filesystem resize max / &> /dev/null
	  else
		echo "Don't know how to grow a $partition_type file system."
		echo ""
	  fi
	  ext4endSector=$(sudo sfdisk -l /dev/mmcblk0 | grep mmcblk0p2 | awk '{print $3}')
	  exfatstartSector=$(echo print 1+$ext4endSector | perl)
	  echo 30
	  # Type 83, Linux: p3 is ext2 now.  Creating it as 11 (W95 FAT32) and correcting
	  # it further down left a window in which a card pulled mid-firstboot reads as a
	  # FAT partition with an ext2 superblock on it, which is what a PC offers to
	  # reformat.  One type, set once.
	  printf "n\np\n3\n$exfatstartSector\n\nt\n3\n83\nw\n" | sudo fdisk /dev/mmcblk0 &> /dev/null
	  echo 45
	fi

	# p3 is ext2 labelled DATA now, not exfat labelled EASYROMS.  The block above
	# deleted and recreated the partition to move its start sector, so its contents are
	# gone either way and it does have to be formatted -- but as the filesystem it
	# already was, so nothing on the device ever has to convert it again.  -b 1024
	# matches setup_partition.sh: many small files in 300 MB and up.
	sudo mkfs.ext2 -F -b 1024 -L DATA /dev/mmcblk0p3 &> /dev/null
	sync
	echo 50
	sleep 2
	sudo e2fsck -fy /dev/mmcblk0p3 &> /dev/null
	sync
	echo 55
	# 83, Linux, and not 7 (HPFS/NTFS/exFAT).  fdisk's type is advisory for Linux --
	# the kernel probes the superblock -- but a partition table that says exFAT over an
	# ext2 filesystem is what makes a PC offer to reformat the card.
	printf "t\n3\n83\nw\n" | sudo fdisk /dev/mmcblk0 &> /dev/null
	echo 60
	sudo mkdir -p ${DATA_MOUNT_POINT}
	sudo mount -t ext2 -w /dev/mmcblk0p3 ${DATA_MOUNT_POINT} &> /dev/null
	exitcode=$?
	echo $exitcode > /tmp/code.txt
	sleep 2
	# --same-owner and --same-permissions now, where the old code passed the opposite:
	# the destination was exfat, which stores neither, and the fstab line handed the
	# whole partition to uid 1000 with umask=000 instead.  ext2 stores both, the archive
	# carries 1000:1000 from finishing_touches.sh, and without these two options the home
	# partition would come out root-owned and read-only to the user that has to write it.
	#
	# -C ${DATA_MOUNT_POINT} and not -C /: the archive is the partition's whole contents
	# now -- the home directory -- rather than a single roms/ top level, because the
	# partition is a home directory and not a rom library.  Extracting it at / would
	# scatter dotfiles across the root filesystem.
	#sudo tar -xf /roms.tar -C ${DATA_MOUNT_POINT} &> /dev/null
	(pv -n /roms.tar | tar --same-permissions --same-owner --warning=no-timestamp -xf - -C ${DATA_MOUNT_POINT}) &> /tmp/tar_stat.txt &
	let COUNT=1
	while true; do
	  VAL=$(tail -n 1 /tmp/tar_stat.txt)
	  if [[ "$VAL" == "100" ]]; then
	   VAL_INT=$(awk "BEGIN {print ($VAL / 100) * 20 + 60}" 2> /dev/null | cut -d '.' -f1)
	   echo $VAL_INT
	   break
	  elif [[ "$VAL" != "$SAMEVAL" ]]; then
	   VAL_INT=$(awk "BEGIN {print ($VAL / 100) * 20 + 60}" 2> /dev/null | cut -d '.' -f1)
	   echo $VAL_INT
	   SAMEVAL="$VAL"
	   continue
	  elif [[ $COUNT -ge 15000 ]]; then
	   echo "We're failing out for restoring the home directory."
	   break
	  else
	   let COUNT++
	   continue
	  fi
	done
	sync
	# ── THE THEME RESTORE THAT USED TO BE HERE ──────────────────────────────
	#
	# It deleted ${DATA_MOUNT_POINT}/roms/themes/es-theme-nes-box, recreated
	# roms/themes, and untarred /tempthemes into it behind a second progress
	# gauge.  All three halves of that are gone: /tempthemes has been an empty
	# directory since the six theme clones were dropped from the build, the roms
	# tree is not created any more, and a theme is read by EmulationStation and
	# by nothing else on this image.
	#
	# It mattered that this went WITH the build-side removal rather than after
	# it: mkdir -p roms/themes here would have put the tree back on the device
	# on the first boot of every card, which is the shape of bug where a
	# directory keeps reappearing and nothing in the build creates it.
	#
	# /tempthemes is still removed below, because a card from an older build has
	# one and this is the only pass that ever looks.
	echo 95
	sleep 1
	sudo rm -rf /tempthemes &> /dev/null
	sleep 2
	# One sweep at the end, belt and braces: this partition on ext2 has to be writable by
	# uid 1000 or the login lands in a home directory it cannot write, and the tar above
	# is only as right about ownership as the archive it came from.  vfat and exfat never
	# needed this -- they have no ownership and the fstab line gave it away with umask=000.
	sudo chown -R 1000:1000 ${DATA_MOUNT_POINT} &> /dev/null
	sudo cp -f /boot/fstab.exfat /etc/fstab &> /dev/null
	sync
	sudo rm -f /boot/doneit* &> /dev/null
	if [ ! -f "/boot/rk3326-rg351v-linux.dtb" ] && [ ! -f "/boot/rk3326-rg351mp-linux.dtb" ] && [ ! -f "/boot/rk3326-g350-linux.dtb" ]; then
	  sudo rm -f /roms.tar &> /dev/null
	fi
	sudo rm -f /boot/fstab.exfat &> /dev/null
	echo 100
) | dialog --title "Firstboot setup of MixOS" --gauge "Expanding the ROOTFS and DATA partitions.  Please wait..." $height $width 0 2>&1 > /dev/tty1

exitcode=$(cat /tmp/code.txt)
if [ "$exitcode" == "0" ]; then
  dialog --infobox "Completed expansion of the root filesystem and the DATA partition. The system will now reboot and load MixOS." $height $width 2>&1 > /dev/tty1 | sleep 10
  systemctl disable firstboot.service &> /dev/null
  sudo rm /boot/firstboot.sh &> /dev/null
  sudo rm -- "$0"
  reboot
else
  dialog --infobox "DATA partition expansion failed for an unknown reason.  Please expand the partition using an alternative tool such as Minitool Partition Wizard.  System will reboot and load MixOS now." $height $width 2>&1 > /dev/tty1 | sleep 10
  systemctl disable firstboot.service &> /dev/null
  sudo rm /boot/firstboot.sh &> /dev/null
  sudo rm -- "$0"
  reboot
fi

