#!/bin/bash

# Minimal launcher for the Debian + EmulationStation R36 build profile.  Keep
# the normal restart/reboot/power-off protocol, but do not reference RetroArch,
# 351Files, gptokeyb, or any other optional bundled application.
export SDL_ASSERT="always_ignore"
export TERM=linux
export XDG_RUNTIME_DIR="/run/user/$UID/"
sudo chmod 666 /dev/tty1 2>/dev/null || true

esdir="$(cd -- "$(dirname -- "$0")" && pwd -P)"
while true; do
    rm -f /tmp/es-restart /tmp/es-sysrestart /tmp/es-shutdown
    "$esdir/emulationstation" "$@"
    ret=$?

    if [[ -f /tmp/es-restart ]]; then
        continue
    elif [[ -f /tmp/es-sysrestart ]]; then
        rm -f /tmp/es-sysrestart
        systemctl reboot
    elif [[ -f /tmp/es-shutdown ]]; then
        rm -f /tmp/es-shutdown
        systemctl poweroff
    fi
    exit "$ret"
done
