--- a/drivers/gpu/drm/mediatek/mtk_ddp_comp.c
+++ b/drivers/gpu/drm/mediatek/mtk_ddp_comp.c
@@ -357,6 +357,7 @@ static const struct mtk_ddp_comp_funcs ddp_ovl = {
 	.unregister_vblank_cb = mtk_ovl_unregister_vblank_cb,
 	.enable_vblank = mtk_ovl_enable_vblank,
 	.disable_vblank = mtk_ovl_disable_vblank,
+	.restore_boot_layer = mtk_ovl_restore_boot_layer,
 	.supported_rotations = mtk_ovl_supported_rotations,
 	.layer_nr = mtk_ovl_layer_nr,
 	.layer_check = mtk_ovl_layer_check,
diff --git a/drivers/gpu/drm/mediatek/mtk_ddp_comp.h b/drivers/gpu/drm/mediatek/mtk_ddp_comp.h
index 3f3d43f43..c32df6404 100644
--- a/drivers/gpu/drm/mediatek/mtk_ddp_comp.h
+++ b/drivers/gpu/drm/mediatek/mtk_ddp_comp.h
@@ -64,6 +64,7 @@ struct mtk_ddp_comp_funcs {
 	void (*unregister_vblank_cb)(struct device *dev);
 	void (*enable_vblank)(struct device *dev);
 	void (*disable_vblank)(struct device *dev);
+	void (*restore_boot_layer)(struct device *dev);
 	unsigned int (*supported_rotations)(struct device *dev);
 	unsigned int (*layer_nr)(struct device *dev);
 	int (*layer_check)(struct device *dev,
@@ -161,6 +162,12 @@ static inline void mtk_ddp_comp_stop(struct mtk_ddp_comp *comp)
 		comp->funcs->stop(comp->dev);
 }
 
+static inline void mtk_ddp_comp_restore_boot_layer(struct mtk_ddp_comp *comp)
+{
+	if (comp->funcs && comp->funcs->restore_boot_layer)
+		comp->funcs->restore_boot_layer(comp->dev);
+}
+
 static inline void mtk_ddp_comp_register_vblank_cb(struct mtk_ddp_comp *comp,
 						   void (*vblank_cb)(void *),
 						   void *vblank_cb_data)
diff --git a/drivers/gpu/drm/mediatek/mtk_disp_drv.h b/drivers/gpu/drm/mediatek/mtk_disp_drv.h
index c0f7f77e0..d30c291ed 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_drv.h
+++ b/drivers/gpu/drm/mediatek/mtk_disp_drv.h
@@ -103,6 +103,7 @@ void mtk_ovl_register_vblank_cb(struct device *dev,
 void mtk_ovl_unregister_vblank_cb(struct device *dev);
 void mtk_ovl_enable_vblank(struct device *dev);
 void mtk_ovl_disable_vblank(struct device *dev);
+void mtk_ovl_restore_boot_layer(struct device *dev);
 u32 mtk_ovl_get_blend_modes(struct device *dev);
 const u32 *mtk_ovl_get_formats(struct device *dev);
 size_t mtk_ovl_get_num_formats(struct device *dev);
diff --git a/drivers/gpu/drm/mediatek/mtk_disp_ovl.c b/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
index ca4a9a60b..49c5645b2 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
@@ -157,6 +157,29 @@ struct mtk_disp_ovl_data {
  * @crtc: associated crtc to report vblank events to
  * @data: platform data
  */
+/*
+ * The overlay programming this driver found already running, kept so that a
+ * board whose bootloader lit the panel can be given it back when the last DRM
+ * client goes away.  See mtk_ovl_restore_boot_layer() and preserve_lk_state.
+ */
+#define MTK_OVL_BOOT_LAYERS	4
+
+struct mtk_ovl_boot_layer {
+	bool	valid;
+	u32	en;
+	u32	roi_size;
+	u32	datapath_con;
+	u32	roi_bgclr;
+	u32	src_con;
+	u32	con[MTK_OVL_BOOT_LAYERS];
+	u32	src_size[MTK_OVL_BOOT_LAYERS];
+	u32	offset[MTK_OVL_BOOT_LAYERS];
+	u32	addr[MTK_OVL_BOOT_LAYERS];
+	u32	pitch[MTK_OVL_BOOT_LAYERS];
+	u32	rdma_ctrl[MTK_OVL_BOOT_LAYERS];
+	u32	rdma_gmc[MTK_OVL_BOOT_LAYERS];
+};
+
 struct mtk_disp_ovl {
 	struct drm_crtc			*crtc;
 	struct clk			*clk;
@@ -165,8 +188,86 @@ struct mtk_disp_ovl {
 	const struct mtk_disp_ovl_data	*data;
 	void				(*vblank_cb)(void *data);
 	void				*vblank_cb_data;
+	struct mtk_ovl_boot_layer	boot;
 };
 
+static unsigned int mtk_ovl_boot_layers(struct mtk_disp_ovl *ovl)
+{
+	return min_t(unsigned int, ovl->data->layer_nr, MTK_OVL_BOOT_LAYERS);
+}
+
+/*
+ * Taken once, at probe, because that is the last moment the bootloader's
+ * programming is still all there: the first modeset runs mtk_ovl_config(),
+ * which pulses DISP_REG_OVL_RST and wipes it.
+ *
+ * It is only meaningful where something really did hand a running overlay
+ * over, so it is marked valid only if the block is enabled, at least one
+ * source is selected and layer 0 has an address.  Nothing reads it unless
+ * mtk_crtc asks, and mtk_crtc only asks on a preserve_lk_state SoC.
+ */
+static void mtk_ovl_save_boot_layer(struct mtk_disp_ovl *ovl)
+{
+	struct mtk_ovl_boot_layer *b = &ovl->boot;
+	unsigned int i, nr = mtk_ovl_boot_layers(ovl);
+
+	b->en = readl(ovl->regs + DISP_REG_OVL_EN);
+	b->roi_size = readl(ovl->regs + DISP_REG_OVL_ROI_SIZE);
+	b->datapath_con = readl(ovl->regs + DISP_REG_OVL_DATAPATH_CON);
+	b->roi_bgclr = readl(ovl->regs + DISP_REG_OVL_ROI_BGCLR);
+	b->src_con = readl(ovl->regs + DISP_REG_OVL_SRC_CON);
+
+	for (i = 0; i < nr; i++) {
+		b->con[i] = readl(ovl->regs + DISP_REG_OVL_CON(i));
+		b->src_size[i] = readl(ovl->regs + DISP_REG_OVL_SRC_SIZE(i));
+		b->offset[i] = readl(ovl->regs + DISP_REG_OVL_OFFSET(i));
+		b->addr[i] = readl(ovl->regs + DISP_REG_OVL_ADDR(ovl, i));
+		b->pitch[i] = readl(ovl->regs + DISP_REG_OVL_PITCH(i));
+		b->rdma_ctrl[i] = readl(ovl->regs + DISP_REG_OVL_RDMA_CTRL(i));
+		b->rdma_gmc[i] = readl(ovl->regs + DISP_REG_OVL_RDMA_GMC(i));
+	}
+
+	b->valid = (b->en & 0x1) && (b->src_con & GENMASK(nr - 1, 0)) &&
+		   b->addr[0] && b->roi_size;
+}
+
+/*
+ * Put the bootloader's frame back on the overlay.  Called from
+ * mtk_crtc_atomic_flush() on a preserve_lk_state SoC once the CRTC has gone
+ * inactive, in place of leaving the panel showing either a black background or
+ * a buffer whose pages are about to be freed.  The caller holds the DDP mutex,
+ * so these land with the rest of that commit.
+ *
+ * Layer registers first, then the source select, then the enable, which is the
+ * order the bootloader itself brings the block up in.
+ */
+void mtk_ovl_restore_boot_layer(struct device *dev)
+{
+	struct mtk_disp_ovl *ovl = dev_get_drvdata(dev);
+	struct mtk_ovl_boot_layer *b = &ovl->boot;
+	unsigned int i, nr = mtk_ovl_boot_layers(ovl);
+
+	if (!b->valid)
+		return;
+
+	writel_relaxed(b->roi_size, ovl->regs + DISP_REG_OVL_ROI_SIZE);
+	writel_relaxed(b->datapath_con, ovl->regs + DISP_REG_OVL_DATAPATH_CON);
+	writel_relaxed(b->roi_bgclr, ovl->regs + DISP_REG_OVL_ROI_BGCLR);
+
+	for (i = 0; i < nr; i++) {
+		writel_relaxed(b->con[i], ovl->regs + DISP_REG_OVL_CON(i));
+		writel_relaxed(b->src_size[i], ovl->regs + DISP_REG_OVL_SRC_SIZE(i));
+		writel_relaxed(b->offset[i], ovl->regs + DISP_REG_OVL_OFFSET(i));
+		writel_relaxed(b->addr[i], ovl->regs + DISP_REG_OVL_ADDR(ovl, i));
+		writel_relaxed(b->pitch[i], ovl->regs + DISP_REG_OVL_PITCH(i));
+		writel_relaxed(b->rdma_gmc[i], ovl->regs + DISP_REG_OVL_RDMA_GMC(i));
+		writel_relaxed(b->rdma_ctrl[i], ovl->regs + DISP_REG_OVL_RDMA_CTRL(i));
+	}
+
+	writel_relaxed(b->src_con, ovl->regs + DISP_REG_OVL_SRC_CON);
+	writel(b->en, ovl->regs + DISP_REG_OVL_EN);
+}
+
 static irqreturn_t mtk_disp_ovl_irq_handler(int irq, void *dev_id)
 {
 	struct mtk_disp_ovl *priv = dev_id;
@@ -642,6 +743,8 @@ static int mtk_disp_ovl_probe(struct platform_device *pdev)
 	priv->data = of_device_get_match_data(dev);
 	platform_set_drvdata(pdev, priv);
 
+	mtk_ovl_save_boot_layer(priv);
+
 	ret = devm_request_irq(dev, irq, mtk_disp_ovl_irq_handler,
 			       IRQF_TRIGGER_NONE, dev_name(dev), priv);
 	if (ret < 0)
@@ -673,6 +776,26 @@ static const struct mtk_disp_ovl_data mt2701_ovl_driver_data = {
 	.num_formats = ARRAY_SIZE(mt8173_formats),
 };
 
+/*
+ * MT6592's OVL is MT2701's -- the same source address register at 0x40, the same
+ * eight GMC bits, the same four layers -- with one enumeration the other way
+ * round.  The bootloader that drives this panel programs OVL_CON with RGB565 =
+ * 0, RGB888 = 1, ARGB8888 = 2, and OVL_CON_CLRFMT_RGB565() keys precisely that
+ * off fmt_rgb565_is_0.  MT2701 numbers those two the other way about, so
+ * borrowing its driver data would transpose the 16- and 24-bit formats.  The
+ * boot path itself is unaffected either way, since XRGB8888 lands on
+ * OVL_CON_CLRFMT_ARGB8888 in both encodings; this is for the first client that
+ * asks for DRM_FORMAT_RGB565.
+ */
+static const struct mtk_disp_ovl_data mt6592_ovl_driver_data = {
+	.addr = DISP_REG_OVL_ADDR_MT2701,
+	.gmc_bits = 8,
+	.layer_nr = 4,
+	.fmt_rgb565_is_0 = true,
+	.formats = mt8173_formats,
+	.num_formats = ARRAY_SIZE(mt8173_formats),
+};
+
 static const struct mtk_disp_ovl_data mt8173_ovl_driver_data = {
 	.addr = DISP_REG_OVL_ADDR_MT8173,
 	.gmc_bits = 8,
@@ -744,6 +867,8 @@ static const struct mtk_disp_ovl_data mt8195_ovl_driver_data = {
 static const struct of_device_id mtk_disp_ovl_driver_dt_match[] = {
 	{ .compatible = "mediatek,mt2701-disp-ovl",
 	  .data = &mt2701_ovl_driver_data},
+	{ .compatible = "mediatek,mt6592-disp-ovl",
+	  .data = &mt6592_ovl_driver_data},
 	{ .compatible = "mediatek,mt8173-disp-ovl",
 	  .data = &mt8173_ovl_driver_data},
 	{ .compatible = "mediatek,mt8183-disp-ovl",
diff --git a/drivers/gpu/drm/mediatek/mtk_drm_drv.c b/drivers/gpu/drm/mediatek/mtk_drm_drv.c
index e169e67e3..508c0cf47 100644
--- a/drivers/gpu/drm/mediatek/mtk_drm_drv.c
+++ b/drivers/gpu/drm/mediatek/mtk_drm_drv.c
@@ -71,6 +71,37 @@ static const unsigned int mt2701_mtk_ddp_ext[] = {
 	DDP_COMPONENT_DPI0,
 };
 
+/*
+ * MT6592's display block is this generation: the register offsets, the OVL
+ * layout, the RDMA FIFO and the MUTEX mod/sof encodings all agree with MT2701.
+ * What differs is the path, and mt2701_mtk_ddp_main[] cannot be reused because
+ * of it -- that array puts DDP_COMPONENT_BLS between COLOR0 and DSI0, and the
+ * bootloader that lights this panel does not.  It routes
+ *
+ *	OVL0 -> RDMA0 -> COLOR0 -> DSI0
+ *
