obj-m += lg_msm8917_touch.o
obj-m += lg_msm8917_audio.o
obj-m += lg_msm8917_wcnss.o
obj-m += lg_msm8917_modem.o
obj-m += lg_msm8917_input.o
obj-m += lg_msm8917_pmic.o
